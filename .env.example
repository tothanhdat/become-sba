# Copy to .env.local and fill in real values. Never commit .env.local.

# Session encryption secret for Auth.js. Generate with `npx auth secret`.
AUTH_SECRET=replace-with-a-random-32-plus-byte-secret

# Google OAuth 2.0 Client ID (Web application type) from Google Cloud Console.
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret paired with AUTH_GOOGLE_ID above.
AUTH_GOOGLE_SECRET=your-google-client-secret

# App base URL. Authorized redirect URI in Google Cloud Console must be {AUTH_URL}/api/auth/callback/google.
AUTH_URL=http://localhost:3000
